{
  "database": "backuprr.sqlite3",
  "article_size": 786432,
  "newsgroup": "alt.binaries.backup",
  "verification_interval_days": 90,
  "scan_interval_seconds": 300,
  "backup_interval_seconds": 300,
  "update_check_interval_seconds": 86400,
  "update_check_enabled": true,
  "update_github_repo": "kelau/Backuprr",
  "update_check_timeout_seconds": 10,
  "queue_strategy": "older-first",
  "auto_pause_auth_failures": 3,
  "auto_pause_provider_failures": 10,
  "compression_sample_bytes": 2097152,
  "compression_min_gain_percent": 5,
  "file_stability_seconds": 300,
  "ui_theme": "harbor_light",
  "external_api_keys": [],
  "log_destinations": [
    {
      "name": "home-loki",
      "platform": "loki",
      "url": "http://127.0.0.1:3100/loki/api/v1/push",
      "api_key": "",
      "username": "",
      "password": "",
      "min_level": "info",
      "timeout_seconds": 5,
      "enabled": false
    }
  ],
  "usenet_hosts": [
    {
      "name": "eweka-read",
      "mode": "read",
      "host": "news.eweka.nl",
      "port": 563,
      "tls": "implicit",
      "username": "",
      "password": ""
    },
    {
      "name": "eweka-post",
      "mode": "post",
      "host": "post.eweka.nl",
      "port": 563,
      "tls": "implicit",
      "username": "",
      "password": ""
    }
  ],
  "endpoints": [],
  "zip_subfolders": false,
  "encrypt_bodies": false,
  "encryption_passphrase_env": "BACKUPRR_ENCRYPTION_PASSPHRASE",
  "par2": {
    "enabled": false,
    "command": "par2",
    "redundancy_percent": 10
  }
}
